# Copy this file to .env for local Compose or the Azure VM.
# Replace every password and secret before exposing any endpoint.

POSTGRES_DB=inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password

JWT_SECRET=change-this-to-a-long-random-jwt-secret

COUCHBASE_ADMINISTRATOR_USERNAME=Administrator
COUCHBASE_ADMINISTRATOR_PASSWORD=change-this-couchbase-password
COUCHBASE_BUCKET=inventory
COUCHBASE_SCOPE=Inventory
COUCHBASE_COLLECTION=InventoryList

KAFKA_KRAFT_CLUSTER_ID=abcdefghijklmnopqrstuv
KAFKA_AUTO_OFFSET_RESET=earliest

# Optional host port overrides.
POSTGRES_PUBLISHED_PORT=5432
KAFKA_PUBLISHED_PORT=9092
COUCHBASE_UI_PUBLISHED_PORT=8091
COUCHBASE_QUERY_PUBLISHED_PORT=8093
COUCHBASE_KV_PUBLISHED_PORT=11210
ORDER_SERVICE_PUBLISHED_PORT=8080
INVENTORY_SERVICE_PUBLISHED_PORT=8081
USER_SERVICE_PUBLISHED_PORT=8082
NOTIFICATION_SERVICE_PUBLISHED_PORT=8083
